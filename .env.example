#Uri do banco de dados mongo
MONGODB_URI=""
#Porta da aplicação
PORT="8081"
#Frontend pra liberação de CORS
FRONTEND_URL="http://192.168.248.201:3000"
#Secret do jwt para geração de tokens
JWT_SECRET="2600bdfba27b..."

#Api key do OpenRouter (https://openrouter.ai/keys) — usada para tradução via IA
OPENROUTER_API_KEY="sk-or-v1-..."
#Modelo padrão do OpenRouter (ver https://openrouter.ai/api/v1/models pra opções gratuitas)
AI_MODEL="google/gemma-4-31b-it:free"
# Endpoint chat-completions usado pela tradução. Default: OpenRouter. Pra rodar
# tradução em massa local (container `ollama` do docker-compose), trocar
# temporariamente por http://ollama:11434/v1/chat/completions (ou
# http://localhost:11434/v1/chat/completions fora do compose) e
# AI_MODEL="translategemma:4b" — modelo dedicado a tradução, sem o overhead de
# "reasoning" de um instruct genérico como o gemma4 (aiService.ts detecta o
# prefixo "translategemma" e troca pro fluxo campo-a-campo automaticamente).
# Não precisa mexer em OPENROUTER_API_KEY, o Ollama ignora o bearer token.
AI_BASE_URL="https://openrouter.ai/api/v1/chat/completions"

#Credenciais do cloudinary
CLOUDINARY_CLOUD_NAME="abs..."
CLOUDINARY_API_KEY="123..."
CLOUDINARY_API_SECRET="ass0..."

# Redis para cache de traduções (opcional, fallback em memória se ausente para a API).
# TTL: 30 dias. Suporta qualquer URL ioredis (redis://, rediss://, redis://user:pass@host:port)
# Obrigatório para o processo worker (bun run worker) — sem ele o worker recusa iniciar (ADR-04).
REDIS_URL="redis://localhost:6379"

# Teto diário de chamadas ao OpenRouter para a conta inteira (API + worker somados).
# Depende do crédito da conta: ~50/dia sem crédito, ~1000/dia com US$10+ (ver ADR-07).
# Subir esse valor só faz sentido se a conta OpenRouter tiver crédito adicionado.
MAX_DAILY_REQUESTS="45"
# Sub-teto do processo worker contra o MESMO contador acima — precisa ser < MAX_DAILY_REQUESTS,
# senão o boot falha (ADR-04). Garante que o caminho on-demand sempre tenha budget sobrando.
WORKER_DAILY_BUDGET="25"
# Idiomas-alvo do worker de tradução de conteúdo, separados por vírgula. `pt` é o idioma de
# origem e nunca deve aparecer aqui.
SUPPORTED_LANGUAGES="en,es,fr,ja,ko,zh,it"